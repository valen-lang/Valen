import v.builtins.result.*;
import v.builtins.box.*;

extern("vale_as_subtype")
func try_as<SubType, SuperType>(left &SuperType) Box<dyn ResultI<&SubType, &SuperType>>
where implements(SubType, SuperType);

extern("vale_as_subtype")
func try_take_as<SubType, SuperType>(left SuperType) Box<dyn ResultI<SubType, SuperType>>
where implements(SubType, SuperType);
