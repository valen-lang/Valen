import v.builtins.box.*;

struct StaticSizedArrayReadonlyIter<N Int, E> {
  arr &StaticArray<N, E>;
  pos int;
}
func begin<N Int, E>(arr &StaticArray<N, E>)
StaticSizedArrayReadonlyIter<N, E> {
  StaticSizedArrayReadonlyIter<N, E>(arr, 0)
}
func next<N Int, E>(iter &StaticSizedArrayReadonlyIter<N, E>) Box<dyn OptI<&E>> {
  if iter.pos < iter.arr.len() {
    Box<dyn OptI<&E>>(Box<SomeI<&E>>(SomeI<&E>(&iter.arr[set iter.pos = iter.pos + 1])))
  } else {
    Box<dyn OptI<&E>>(Box<NoneI<&E>>(NoneI<&E>()))
  }
}
