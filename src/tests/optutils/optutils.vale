import v.builtins.box.*;

abstract func getOr<T>(virtual opt &OptI<T>, default T) T;
func getOr<T>(opt &NoneI<T>, default T) T {
  return default;
}
func getOr<T>(opt &SomeI<T>, default T) T {
  return opt.value;
}

abstract func map<T, R>(virtual opt &OptI<T>, func &dyn IFunction1<&T, R>) Box<dyn OptI<R>>;
func map<T, R>(opt &NoneI<T>, func &dyn IFunction1<&T, R>) Box<dyn OptI<R>> {
  return Box<dyn OptI<R>>(Box<NoneI<R>>(NoneI<R>()));
}
func map<T, R>(opt &SomeI<T>, func &dyn IFunction1<&T, R>) Box<dyn OptI<R>> {
  return Box<dyn OptI<R>>(Box<SomeI<R>>(SomeI<R>(func(opt.value))));
}

abstract func len<T>(virtual opt &OptI<T>) int;
func len<T>(opt &NoneI<T>) int { return 0; }
func len<T>(opt &SomeI<T>) int { return 1; }
