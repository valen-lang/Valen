
struct Muta share { hp int; }
sealed interface IUnit share { func getHp(virtual self weak IUnit) int; }
impl IUnit for Muta;
func getHp(self weak Muta) int {
  maybeBorrowSelf = lock(self);
  return if (maybeBorrowSelf.isEmpty()) {
      drop(^maybeBorrowSelf);
      42
    } else {
      // TSUGAR:       (maybeBorrowSelf).get().hp
      __copy_prim(&(^maybeBorrowSelf).get().hp)
    };
}

exported func main() int {
  ownMuta = Muta(73);
  weakUnit weak IUnit = weak ownMuta;
  drop(^ownMuta);
  return getHp(weakUnit);
}