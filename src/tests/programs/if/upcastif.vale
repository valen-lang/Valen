import v.builtins.box.*;

interface I {
  func moo(virtual this &I) int;
}
struct A {}
impl I for A;
struct B {}
impl I for B;

func moo(a &A) int { return 73; }
func moo(b &B) int { return 42; }

exported func main() int {
  myVar Box<dyn I> = if (false) { Box<dyn I>(Box<A>(A())) } else { Box<dyn I>(Box<B>(B())) };
  return moo(&myVar);
}
