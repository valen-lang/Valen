import v.builtins.arith.*;
struct Spaceship { fuel int; }
func foo(ship Spaceship) Spaceship {
  [oldFuel] = ^ship;
  // TSUGAR:   return Spaceship(oldFuel + 7);
  return Spaceship(__copy_prim(&oldFuel) + 7);
}
exported func main() int {
  ship = Spaceship(35);
  0; // lldb breakpoint: restackify-before
  set ship = foo(^ship);
  0; // lldb breakpoint: restackify-after
  [x] = ^ship;
  return ^x;
}
