


sealed interface MyInterface<T> {
  func doThing(virtual x MyInterface<T>) int;
}

struct MyStruct<T> { }
impl<T> MyInterface<T> for MyStruct<T>;
func doThing<T>(x MyStruct<T>) int { return 4; }

exported func main() int {
  x = MyStruct<int>();
  y = MyStruct<str>();
  doThing(^x);
  return doThing(^y);
}
