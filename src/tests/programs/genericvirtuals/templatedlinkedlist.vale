import v.builtins.opt.*;
import v.builtins.logic.*;
import v.builtins.drop.*;
import v.builtins.box.*;
import printutils.*;

#!DeriveStructDrop
struct MyList<T> {
  value T;
  next Box<dyn Opt<MyList<T>>>;
}

func drop<T>(this MyList<T>)
where func drop(T)void {
  [value, next] = ^this;
}

func printValues(list &MyList<int>) void {
  // TSUGAR:   print(list.value);
  print(__copy_prim(&list.value));
  printNextValue(&list.next);
}

func printNextValue(opt &dyn Opt<MyList<int>>) void {
  // TSUGAR:   if not opt.isEmpty() {
  if not opt.isEmpty() {
    printValues(opt.get());
  }
}


exported func main() int {
  list = MyList<int>(10, Box<dyn Opt<MyList<int>>>(Box<Some<MyList<int>>>(Some<MyList<int>>(MyList<int>(20, Box<dyn Opt<MyList<int>>>(Box<Some<MyList<int>>>(Some<MyList<int>>(MyList<int>(30, Box<dyn Opt<MyList<int>>>(Box<None<MyList<int>>>(None<MyList<int>>())))))))))));
  printValues(&list);
  return 0;
}
