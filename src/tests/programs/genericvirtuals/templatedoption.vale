import v.builtins.drop.*;
import v.builtins.box.*;

interface MyOption<T> { }

struct MySome<T> where func drop(T)void {
  value T;
}
impl<T> MyOption<T> for MySome<T>;

struct MyNone<T> { }
impl<T> MyOption<T> for MyNone<T>;

abstract func len<T>(virtual opt &MyOption<T>) int;
func len<T>(opt &MyNone<T>) int { return 0; }
func len<T>(opt &MySome<T>) int { return 1; }

exported func main() int {
  myOpt Box<dyn MyOption<int>> = Box<dyn MyOption<int>>(Box<MySome<int>>(MySome<int>(4)));
  return len(&myOpt);
}
