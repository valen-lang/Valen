import v.builtins.box.*;

exported interface IShip share { }
abstract func getFuel(virtual ship &IShip) int;

exported struct Firefly share { fuel int; }
impl IShip for Firefly;
func getFuel(ship Firefly) int { ship.fuel }

exported func valeMakeShip() Box<dyn IShip> {
  Box<dyn IShip>(Box<Firefly>(Firefly(42)))
}

extern func cMakeShip() Box<dyn IShip>;

exported func main() int {
  res = cMakeShip();
  return getFuel(&res);
}
