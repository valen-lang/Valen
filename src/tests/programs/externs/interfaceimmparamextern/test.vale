import v.builtins.box.*;

exported interface IShip share { }

exported struct Spaceship share { fuel int; }
impl IShip for Spaceship;

exported struct Seaship share { leftFuel int; rightFuel int; }
impl IShip for Seaship;

extern func cGetShipFuel(s Box<dyn IShip>) int;

exported func main() int {
  x Box<dyn IShip> = Box<dyn IShip>(Box<Spaceship>(Spaceship(7))); // to force the above impl to happen
  cGetShipFuel(Box<dyn IShip>(Box<Seaship>(Seaship(37, 5))))
}
