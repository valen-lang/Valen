
import v.builtins.box.*;

exported struct Engine share { fuel int; }

exported interface IShip share { }

exported struct Spaceship share { engine Engine; }
impl IShip for Spaceship;

exported struct Seaship share { unused int; }
impl IShip for Seaship;

abstract func getFuel(virtual this IShip) int;
func getFuel(this Spaceship) int { this.engine.fuel }
func getFuel(this Seaship) int { return 0; }

exported func valeGetShipFuel(s Box<dyn IShip>) int {
  return s.getFuel();
}

extern func cGetShipFuel(s Box<dyn IShip>) int;

exported func main() int {
   cGetShipFuel(Box<dyn IShip>(Box<Spaceship>(Spaceship(Engine(42)))))
}
