// Interface with a single impl — edge case for tag dispatch (does the tag
// switch cover exactly one case? does the auto-gen'd tag emit a valid single
// tag constant?).
import v.builtins.box.*;

exported interface OnlyOne share { }

exported struct TheOne share { val int; }
impl OnlyOne for TheOne;

extern func handleIt(o Box<dyn OnlyOne>) int;

exported func main() int {
  x Box<dyn OnlyOne> = Box<dyn OnlyOne>(Box<TheOne>(TheOne(1))); // force the impl to happen
  return handleIt(Box<dyn OnlyOne>(Box<TheOne>(TheOne(42))));
}
