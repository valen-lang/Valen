// Isolates the auto-gen'd IFoo_typeTag + IFoo_asBar + TAG_* constants for
// interface dispatch from C. Three-impl interface exercises all three
// downcast primitives.
sealed exported interface IShape share { }

exported struct Circle share { radius int; }
impl IShape for Circle;

exported struct Square share { side int; }
impl IShape for Square;

exported struct Triangle share { base int; height int; }
impl IShape for Triangle;

extern func computeArea(s IShape) int;

exported func main() int {
  x IShape = Circle(1);
  y IShape = Square(1);
  z IShape = Triangle(1, 1);
  return computeArea(Triangle(6, 14));
}
