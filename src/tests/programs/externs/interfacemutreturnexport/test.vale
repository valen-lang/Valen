import v.builtins.box.*;

exported interface IShip {
  func getFuel(virtual ship &IShip) int;
}
exported struct Firefly {
  fuel int;
}
impl IShip for Firefly;
// TSUGAR: func getFuel(ship &Firefly) int { ship.fuel }
func getFuel(ship &Firefly) int { __copy_prim(ship.fuel) }

exported func makeFirefly(fuel int) Box<dyn IShip> {
  Box<dyn IShip>(Box<Firefly>(Firefly(fuel)))
}

extern func runExtCommand() Box<dyn IShip>;

exported func main() int {
  res = runExtCommand();
  return getFuel(&res);
}
