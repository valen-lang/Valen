


import v.builtins.box.*;

interface Car {
  func doCivicDance(virtual this &Car) int;
}

struct Civic {}
impl Car for Civic;
func doCivicDance(civic &Civic) int {
  return 4;
}

struct Toyota {}
impl Car for Toyota;
func doCivicDance(toyota &Toyota) int {
  return 7;
}

exported func main() int {
  x Box<dyn Car> = Box<dyn Car>(Box<Toyota>(Toyota()));
  b = &x;
  return doCivicDance(b);
}
