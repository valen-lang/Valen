

import printutils.*;
import v.builtins.box.*;

interface MyOption share { }

struct MySome share {
  value MyList;
}
impl MyOption for MySome;

struct MyNone share { }
impl MyOption for MyNone;


struct MyList share {
  value int;
  next Box<dyn MyOption>;
}

func printValues(list MyList) void {
  // TSUGAR:   print(list.value);
  print(__copy_prim(list.value));
  printNextValue(list.next);
}

func printNextValue(virtual opt MyOption) void { }
func printNextValue(opt MyNone) void { }
func printNextValue(opt MySome) void {
  printValues(opt.value);
}


exported func main() int {
  list = MyList(10, Box<dyn MyOption>(Box<MySome>(MySome(MyList(20, Box<dyn MyOption>(Box<MySome>(MySome(MyList(30, Box<dyn MyOption>(Box<MyNone>(MyNone())))))))))));
  printValues(list);
  return 0;
}
