
import v.builtins.box.*;
interface MyOption { }

struct MySome {
  value MyList;
}
impl MyOption for MySome;

struct MyNone { }
impl MyOption for MyNone;


struct MyList {
  value int;
  next Box<dyn MyOption>;
}

func sum(list &MyList) int {
  list.value + sum(&list.next)
}

abstract func sum(virtual opt &MyOption) int;
func sum(opt &MyNone) int { return 0; }
func sum(opt &MySome) int {
   sum(&opt.value)
}


exported func main() int {
  list = MyList(7, Box<dyn MyOption>(Box<MySome>(MySome(MyList(17, Box<dyn MyOption>(Box<MySome>(MySome(MyList(18, Box<dyn MyOption>(Box<MyNone>(MyNone())))))))))));
  return sum(&list);
}
