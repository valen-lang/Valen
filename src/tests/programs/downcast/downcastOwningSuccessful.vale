
import v.builtins.box.*;
interface IShip  {}

struct Serenity {}
impl IShip for Serenity;

struct Raza { fuel int; }
impl IShip for Raza;

func moo(ship Box<dyn IShip>) int {
  maybeRaza Box<dyn ResultI<Raza, Box<dyn IShip>>> = (^ship).try_take_as<Raza>();
  return if (maybeRaza.is_ok()) {
      // TSUGAR:       maybeRaza.expect("wat").fuel
      __copy_prim(maybeRaza.expect("wat").fuel)
    } else {
      72
    };
}
exported func main() int {
  return moo(Box<dyn IShip>(Box<Raza>(Raza(42))));
}
